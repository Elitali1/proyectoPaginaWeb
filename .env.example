# Copiá este archivo como .env y completá los valores. El .env real NO se sube al repositorio.

# ---- Base de datos (PostgreSQL / Neon)
DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# ---- Sesiones
# Cadena larga y aleatoria. Ej: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Opcionales (valores por defecto entre paréntesis)
# BCRYPT_SALT_ROUNDS=12
# MAX_FAILED_LOGIN=5        # intentos fallidos antes de bloquear la cuenta
# LOCK_MINUTES=15           # minutos de bloqueo

# ---- Servidor
# PORT=3000
# NODE_ENV=production
# TRUST_PROXY=1             # cantidad de proxies delante del servidor (probá 2 si Cloudflare + Railway comparten IP)
FRONTEND_URL=https://www.donchichopizza.com.ar

# ---- Facturación electrónica ARCA/AFIP
ARCA_CUIT=
ARCA_PTO_VTA=
ARCA_CBTE_TIPO=11
# En producción se inyectan los certificados como variables (en local se leen de la carpeta certificados-arca/)
# ARCA_CERT=
# ARCA_KEY=
# ARCA_PRODUCTION=false     # false = homologación (con certificados de prueba). Por defecto es producción.
# ARCA_FECHA_ART_DESDE=     # ver README: corrige la fecha de comprobantes emitidos entre las 21:00 y las 24:00

# ---- Email (Brevo)
BREVO_API_KEY=
SENDER_EMAIL=
SENDER_NAME=Donchichopizza

# ---- Imágenes (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Agente de impresión (solo en la PC del local)
API_URL_PRODUCCION=https://www.donchichopizza.com.ar
AGENTE_TOKEN=
